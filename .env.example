# OpenMontage - Environment Variables
# Copy this to .env and fill in your keys

# ── Web Platform (new) ────────────────────────────────────────────────────────
ACCESS_PASSPHRASE=your-team-passphrase-here   # v1 shared auth gate
NEXT_PUBLIC_APP_URL=http://localhost:3000
SERVER_URL=http://localhost:8000              # FastAPI sidecar (internal)

# Database (Postgres via Docker Compose)
DATABASE_URL=postgresql://openmontage:openmontage@localhost:5432/openmontage
POSTGRES_USER=openmontage
POSTGRES_PASSWORD=openmontage
POSTGRES_DB=openmontage

# Storage backend (local | s3)
STORAGE_BACKEND=local

# ── Image + video gateway ─────────────────────────────────────────────────────
#  FLUX images, Google Veo video, Kling video, MiniMax video, Recraft images
FAL_KEY=
                             # Get one at https://fal.ai/dashboard/keys

# --- Google (one key unlocks image gen + TTS) ---
#  Google Imagen images, Google Cloud TTS (700+ voices, 50+ languages)
GOOGLE_API_KEY=
                             # Get one at https://aistudio.google.com/apikey
# Alternative to the API key: service-account JSON auth.
# TTS uses Cloud Text-to-Speech; Imagen routes to Vertex AI.
#  path to a service-account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=
#  GCP project id (required for Imagen via Vertex AI)
GOOGLE_CLOUD_PROJECT=
#  Vertex AI region, default us-central1
GOOGLE_CLOUD_LOCATION=

# --- Voice ---
#  TTS narration, music generation, sound effects
ELEVENLABS_API_KEY=
#  OpenAI TTS fallback and GPT Image 2 image generation
OPENAI_API_KEY=
#  Grok image generation/editing and Grok video generation
XAI_API_KEY=
#  Volcengine Doubao Speech TTS (new console API Key)
DOUBAO_SPEECH_API_KEY=
#  Default Doubao speaker/voice type, e.g. zh_female_vv_uranus_bigtts
DOUBAO_SPEECH_VOICE_TYPE=
# Piper local voices do not require env vars; install `piper-tts` via pip

# --- Music ---
#  Suno AI music generation (full songs, instrumentals, any genre)
SUNO_API_KEY=

# --- Video Generation ---
#  HeyGen API (VEO, Sora, Runway, Kling, Seedance via single key)
HEYGEN_API_KEY=
#  Runway Gen-4 (direct API, alternative to fal.ai routing)
RUNWAY_API_KEY=
#  MiniMax (Hailuo) direct API key — used by the minimax_video_direct tool
MINIMAX_API_KEY=
#  API base; default https://api.minimaxi.com (China), or https://api.minimax.io (global)
MINIMAX_API_BASE=
#  Default model, e.g. MiniMax-Hailuo-02 (also T2V-01 / I2V-01)
MINIMAX_VIDEO_MODEL=
#  Set to "true" for local video gen (needs GPU + diffusers)
VIDEO_GEN_LOCAL_ENABLED=
#  Local model: wan2.1-1.3b, wan2.1-14b, hunyuan-1.5, ltx2-local, cogvideo-5b
VIDEO_GEN_LOCAL_MODEL=
#  Modal self-hosted LTX-2 endpoint (optional)
MODAL_LTX2_ENDPOINT_URL=

# --- Stock Media ---
#  Pexels stock footage/images (free)
PEXELS_API_KEY=
#  Pixabay stock footage/images (free)
PIXABAY_API_KEY=
#  Unsplash stock images (free developer key)
UNSPLASH_ACCESS_KEY=

# --- Analysis ---
#  HuggingFace token — enables speaker diarization in transcriber
HF_TOKEN=

# --- Avatar (local installs) ---
# WAV2LIP_PATH=              # Path to cloned Wav2Lip repo (for lip sync)
# SADTALKER_PATH=            # Path to cloned SadTalker repo (for talking head avatars)

# ─── Web platform: LLM brain + capability-selector provider pinning ───────────
# The web platform's agent brain is any OpenAI-compatible chat endpoint. Default
# is Together AI. It intentionally does NOT reuse MAAS_* (retired generation
# gateway), so an LLM key never reactivates maas_tts/maas_image/maas_video.
LLM_API_KEY=
# Base URL for the LLM (OpenAI-compatible). Default: https://api.together.xyz
LLM_API_BASE=
# Chat model id; must support tool/function calling. Default: MiniMaxAI/MiniMax-M3
LLM_MODEL=
# Pin the capability selectors to specific providers (comma-separated provider
# names, matching each tool's `provider`). Prevents the scored ranker from
# choosing a listed-but-broken provider. Leave blank for automatic ranking.
OM_TTS_PROVIDERS=
OM_IMAGE_PROVIDERS=
OM_VIDEO_PROVIDERS=
